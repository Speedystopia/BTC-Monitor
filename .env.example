# Settings of docker-compose.yml. Copy this file to .env and fill it in.
# .env holds your stream keys: never commit it nor show it on stream.

# ---- HTTPS (docker compose --profile https)
# Domain name pointing to this server (DNS A record), ports 80 and 443 open.
# With AdSense, use the domain itself (example.com), not a subdomain: Google reads example.com/ads.txt
DOMAIN=example.com

# ---- Legal notice and privacy page (https://DOMAIN/privacy.html, linked from the dashboard):
# required in France and by AdSense. Examples:
#   SITE_EDITOR=Jean Dupont, 12 rue de la Paix, 75002 Paris
#   SITE_CONTACT=contact@example.com
#   SITE_HOSTING=name of the hosting company, its address and phone number (on its website)
SITE_EDITOR=
SITE_CONTACT=
SITE_HOSTING=

# ---- Google AdSense (README > Publicité): empty = no ads. Never shown in the stream nor in OBS.
# Publisher id (AdSense > Account > Account information): ca-pub-0000000000000000
ADSENSE_CLIENT=
# Display ad unit id (AdSense > Ads > By ad unit), digits only; empty until the site is approved
ADSENSE_SLOT=

# ---- Live stream (docker compose --profile stream): at least one destination
# YouTube Studio > Go live > Stream key; Twitch > Creator dashboard > Settings > Stream > Primary stream key
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
# Other destinations: full RTMP(S) addresses separated by spaces (Kick, Facebook, Restream...)
RTMP_URLS=
# Page sent (timeframe and display options, as in OBS): ?tf=15m&heatmap=1&sessions=0&heatgain=1.5
# (the streamer adds ads=0: no ads, no legal link in the stream)
STREAM_PAGE=http://btc-monitor:8787/?tf=5m
# Picture: 1920x1080 at 30 fps takes about 1 CPU core and 700 MB (plan 2 vCPU), 1280x720 about half.
# Upload: the bitrate for each destination. Twitch accepts up to 6000k.
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE=6000k
# 1 = the alert sounds are in the stream, 0 = silent audio track
STREAM_AUDIO=1
