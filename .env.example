# Settings of docker-compose.yml. Copy this file to .env and fill it in.
# .env holds your stream keys: never commit it nor show it on stream.

# ---- HTTPS (docker compose --profile https)
# Domain name pointing to this server (DNS A record), ports 80 and 443 open
DOMAIN=btc.example.com

# ---- Live stream (docker compose --profile stream): at least one destination
# YouTube Studio > Go live > Stream key; Twitch > Creator dashboard > Settings > Stream > Primary stream key
YOUTUBE_STREAM_KEY=
TWITCH_STREAM_KEY=
# Other destinations: full RTMP(S) addresses separated by spaces (Kick, Facebook, Restream...)
RTMP_URLS=
# Page sent (timeframe and display options, as in OBS): ?tf=15m&heatmap=1&sessions=0&heatgain=1.5
STREAM_PAGE=http://btc-monitor:8787/?tf=5m
# Picture: 1920x1080 at 30 fps takes about 1 CPU core and 700 MB (plan 2 vCPU), 1280x720 about half.
# Upload: the bitrate for each destination. Twitch accepts up to 6000k.
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE=6000k
# 1 = the alert sounds are in the stream, 0 = silent audio track
STREAM_AUDIO=1
